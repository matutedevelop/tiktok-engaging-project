# Copia este archivo como .env (ignorado por git) y llena los valores locales.

# --- Databricks / MLflow (flow de entrenamiento y API) ---
DATABRICKS_HOST=https://<identificador-del-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<token>
TRACKING_URI=databricks
REGISTRY_URI=databricks-uc
MLFLOW_CATALOG=workspace
# El equipo registra en un esquema propio en lugar de `default`
MLFLOW_SCHEMA=tiktok-engaging-estimator

# --- API (src/api) ---
# Nombre de tres niveles, sin `models:/` y sin alias
MODELO_REGISTRADO=workspace.tiktok-engaging-estimator.pcd_otono_2026_tiktok_engaging_estimator
ALIAS_MODELO=champion
# Contingencia sin Databricks: ruta a un MLflow Model local confiable (deja vacío para usar el Registry)
RUTA_MODELO_LOCAL=

# --- Frontend (src/frontend) ---
API_URL=http://127.0.0.1:8000/api/v1/predicciones
